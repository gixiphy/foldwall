    "27 吋以上才看得出跟 1080p 的差別。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only tells apart from 1080p on 27-inch displays and larger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "27 英寸以上才看得出跟 1080p 的差别。"

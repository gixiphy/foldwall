{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "%@ 未登入或憑證已失效，請在終端重新登入後再試": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not logged in or its credentials have expired. Log in again in Terminal and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未登录或凭证已失效，请在终端重新登录后再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未登入或憑證已失效，請在終端重新登入後再試"
          }
        }
      }
    },
    "%@ 沒有產出回應，可重試": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ produced no response. You can retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有产生回应，可重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有產出回應，可重試"
          }
        }
      }
    },

            "value": "此螢幕改用影片"
          }
        }
      }
    },
    "每個來源的**開關**、資料夾用途、選中的相簿都留在這台。在筆電關掉 Pexels 不會讓桌機也跟著關；目錄裡新出現的來源在每台都是**預設開著**。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each source's **on/off switch**, folder roles and selected albums stay on this Mac. Turning Pexels off on the laptop won't turn it off on the desktop; a source that newly appears in the catalog arrives **enabled** on every Mac."
          }
        }
      }
    },
    "每台螢幕張數上限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-display limit"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台螢幕張數上限"
          }
        }
      }
    },
    "池 %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld in pool"
          }
        },
        "zh-Hant": {

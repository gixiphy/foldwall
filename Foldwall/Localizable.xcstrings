        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“完全磁盘访问权限”里把 Foldwall 打开，然后回来再测一次。列表里没有 Foldwall 的话，用左下角的 ＋ 从“应用程序”里加进去。"
          }
        },
        "zh-Hant": {

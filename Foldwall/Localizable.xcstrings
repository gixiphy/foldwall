    "Foldwall 以 MIT 授權釋出。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldwall is released under the MIT license."
          }
        },
        "zh-Hans": {
          "stringUnit": {

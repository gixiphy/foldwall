    },
    "例如 https://photos.example.com（可只填主機名）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example https://photos.example.com (a hostname alone is fine)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如 https://photos.example.com（可只填主機名）。"
          }
        }
      }
    },
    "例如：靠電池時停用網路來源；工作模式時暫停影片桌布。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: disable web sources on battery; pause video wallpaper in Work focus."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：靠電池時停用網路來源；工作模式時暫停影片桌布。"
          }
        }
      }
    },
    "借瀏覽器的登入狀態": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrow a Browser Sign-In"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "借瀏覽器的登入狀態"
          }
        }
      }
    },
    "借登入狀態": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrow sign-in from"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

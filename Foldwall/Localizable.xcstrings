            "value": "取消"
          }
        }
      }
    },
    "受限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restricted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受限"
          }
        }
      }
    },
    "只抓視訊軌，不抓音訊——桌布本來就靜音播放，音訊抓下來只是佔空間。同一個解析度底下挑位元率最高的那條流：站方常常把最糊的那條排在最前面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video track only, no audio: wallpapers play muted, so an audio track would just take up space. Within a resolution, the highest-bitrate stream wins — sites often list the blurriest one first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只抓視訊軌，不抓音訊——桌布本來就靜音播放，音訊抓下來只是佔空間。同一個解析度底下挑位元率最高的那條流：站方常常把最糊的那條排在最前面。"
          }
        }
      }
    },
    "可以用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

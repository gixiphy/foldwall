          "stringUnit": {
            "state": "translated",
            "value": " (%@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（%@）"
          }
        }
      }
    },
    "（這個站只提供分離的視訊／音訊軌，合併需要 ffmpeg：`brew install ffmpeg`）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (this site only serves separate video and audio tracks; merging them needs ffmpeg: `brew install ffmpeg`)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（這個站只提供分離的視訊／音訊軌，合併需要 ffmpeg：`brew install ffmpeg`）"

          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源無可用影像"
          }
        }
      }
    },
    "來源目錄是較新的格式（v%lld），請先更新這台的 Foldwall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source catalog is in a newer format (v%lld). Update Foldwall on this Mac first."
          }
        }
      }
    },
    "來源離線 %lld 個": {
      "localizations": {

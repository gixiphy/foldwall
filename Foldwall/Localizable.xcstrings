          }
        }
      }
    },
    "備份到 iCloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Up to iCloud"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份到 iCloud"
          }
        }
      }
    },
    "備份檔是明文 JSON，放在 iCloud Drive 裡會被 Spotlight 索引。換機器時到「來源」分頁重輸一次。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup is plain-text JSON, and Spotlight indexes it in iCloud Drive. Re-enter it on the Sources tab when you switch machines."
          }
        }
      }
    },
    "備份這台的設定失敗：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't back up this Mac's settings: %@"
          }
        }
      }
    },
    "儲存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存"
          }
        }

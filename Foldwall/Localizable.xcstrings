    },
    "找不到 yt-dlp。用 `brew install yt-dlp` 安裝後再試。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp not found. Install it with `brew install yt-dlp` and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 yt-dlp。用 `brew install yt-dlp` 安裝後再試。"
          }
        }
      }
    },
    "拷貝中…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝中…"
          }
        }
      }
    },
    "指定的上限對所有螢幕一體適用。每輪實際幾張是在 1 到上限之間隨機決定的——有時一張大圖、有時鋪滿十幾張。每台螢幕各自抽圖、各自合成，同一時間兩台不會是同一張。降載時上限封頂 6 張。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit you set applies to every display alike. How many actually appear each round is drawn at random between 1 and the limit — sometimes one large image, sometimes a dozen tiled. Every display draws and composes on its own, so no two show the same thing at once. Under power saving the limit is capped at 6."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指定的上限對所有螢幕一體適用。每輪實際幾張是在 1 到上限之間隨機決定的——有時一張大圖、有時鋪滿十幾張。每台螢幕各自抽圖、各自合成，同一時間兩台不會是同一張。降載時上限封頂 6 張。"
          }
        }
      }
    },
    "掃描中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "scanning"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描中"
          }
        }
      }
    },
    "掃描中…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

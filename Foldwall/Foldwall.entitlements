<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- v1 不沙盒：刻意不設 com.apple.security.app-sandbox -->
	<!-- 影片 extension 需 dlopen 私有 WallpaperExtensionKit -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Hardened Runtime 下，即使不沙盒，TCC 也要求這個 entitlement 才**准許跳出**
	     照片授權框。缺了它 tccd 會直接回：
	       "Prompting policy for hardened runtime; service: kTCCServicePhotos
	        requires entitlement com.apple.security.personal-information.photos-library"
	     結果是使用者永遠看不到授權框，app 也不會出現在 系統設定 → 隱私權 → 照片 清單裡。 -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
